{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "rainfall_pipeline/api/static",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(app.css|app.js)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/demo/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
    }
  ]
}
